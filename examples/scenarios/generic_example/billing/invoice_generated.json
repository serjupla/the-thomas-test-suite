{
  "schema_version": 1,
  "feature": "billing",
  "scenario_id": "invoice_generated",
  "description": "A fictional invoice request awaits later validation against a data store (out of scope for F00)",
  "endpoint": { "method": "POST", "path": "/invoices" },
  "payload": {
    "customer_id": "{{fake_customer_id}}",
    "amount": 99.9
  },
  "correlation": { "source": "api_response", "field": "$.invoice_id" },
  "api_checks": [
    { "id": "http_status", "field": "status_code", "operator": "equals", "expected_value": 202 }
  ],
  "validations": [
    {
      "id": "invoice_persisted",
      "connector": "oracle_main",
      "query": "SELECT STATUS FROM FICTIONAL_INVOICES WHERE ID = :correlation_id",
      "field": "STATUS",
      "operator": "equals",
      "expected_value": "GENERATED"
    }
  ]
}
