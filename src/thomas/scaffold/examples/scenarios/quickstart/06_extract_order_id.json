{
  "schema_version": 1,
  "feature": "extract_variables_chaining",
  "scenario_id": "extract_order_id",
  "description": "Demonstrates extract_variables: creates a resource and pulls its id out of the response into the order_id variable for the next scenario to consume.",
  "endpoint": {
    "method": "POST",
    "path": "/posts"
  },
  "payload": {
    "title": "order-{{post_title}}",
    "body": "{{post_body}}",
    "userId": "{{user_id}}"
  },
  "api_checks": [
    { "id": "status_created", "field": "status_code", "operator": "equals", "expected_value": 201 }
  ],
  "extract_variables": [
    { "json_path": "$.id", "as_variable": "order_id" }
  ]
}
