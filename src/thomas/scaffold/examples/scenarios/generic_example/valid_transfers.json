{
  "schema_version": "1.0",
  "feature": "transfers",
  "description": "Test successful transfer with valid account",
  "request": {
    "method": "POST",
    "path": "/transfers",
    "body": {
      "account_id": "{{account_id}}",
      "amount": "{{transfer_amount}}"
    }
  },
  "api_checks": [
    {
      "path": "status_code",
      "operator": "equals",
      "expected": 200
    },
    {
      "path": "body.status",
      "operator": "equals",
      "expected": "completed"
    }
  ],
  "validations": []
}
