{
  "schema_version": 1,
  "environment_name": "example-public-api",
  "system_name": "JSONPlaceholder (public demo API)",
  "timezone": "UTC",
  "report_language": "en",
  "company_logo_path": "../company-logo.svg",
  "apis": {
    "identity_service": {
      "base_url": "https://jsonplaceholder.typicode.com",
      "timeout_seconds": 30,
      "default": true
    },
    "business_api": {
      "base_url": "https://jsonplaceholder.typicode.com",
      "timeout_seconds": 30,
      "headers": {
        "X-Api-Key": "fictional-business-api-key"
      }
    }
  },
  "connectors": {
    "fake_ledger": {
      "type": "fake",
      "values": {
        "order_confirmed": "confirmed"
      },
      "failures": {}
    },
    "db2_main": {
      "type": "db2",
      "connection_string": "DATABASE=fictional_db;HOSTNAME=fictional-db2-host;PORT=50000;PROTOCOL=TCPIP;",
      "username": "fictional_db2_user",
      "password": "fictional-db2-password"
    },
    "kafka_main": {
      "type": "kafka",
      "brokers": ["fictional-kafka-broker1:9092", "fictional-kafka-broker2:9092"],
      "username": "fictional_kafka_user",
      "password": "fictional-kafka-password"
    }
  }
}
